# Railway injects PORT automatically.
PORT=3000

# Optional. Visitors must enter this token before reading codes when set.
ACCESS_TOKEN=change-this-access-token

# direct = read mailbox with Microsoft Graph refresh_token.
# oauth2 = call https://tools.dongvanfb.net/api/get_code_oauth2.
# dongvan = call https://tools.dongvanfb.net/api/graph_code instead.
# dongvan_fallback = try DongVan first, then direct Graph if no code.
CODE_PROVIDER=direct

# Direct Microsoft Graph settings.
MICROSOFT_TOKEN_ENDPOINT=https://login.microsoftonline.com/common/oauth2/v2.0/token
MICROSOFT_GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0
MICROSOFT_TOKEN_SCOPES=https://graph.microsoft.com/Mail.Read offline_access|https://graph.microsoft.com/.default
MAIL_TOP=30
DISPLAY_TIME_ZONE=Asia/Ho_Chi_Minh

# DongVanFB endpoints.
OAUTH2_CODE_ENDPOINT=https://tools.dongvanfb.net/api/get_code_oauth2
GRAPH_CODE_ENDPOINT=https://tools.dongvanfb.net/api/graph_code

# Optional tuning.
MAX_ACCOUNTS_PER_REQUEST=200
REQUEST_TIMEOUT_MS=45000
